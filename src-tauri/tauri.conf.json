{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SeeRead",
  "version": "0.1.0",
  "identifier": "app.seeread.SeeRead",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "SeeRead",
        "url": "index.html",
        "width": 1100,
        "height": 720,
        "minWidth": 720,
        "minHeight": 520,
        "center": true
      },
      {
        "label": "overlay",
        "title": "SeeRead Teleprompter",
        "url": "overlay.html",
        "width": 900,
        "height": 320,
        "minWidth": 240,
        "minHeight": 120,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Privacy-conscious teleprompter with local voice tracking",
    "longDescription": "SeeRead is an open-source desktop teleprompter with a floating overlay, local voice tracking, automatic scrolling and stage-direction annotations.",
    "copyright": "Copyright 2026 SeeRead contributors. Licensed under Apache-2.0.",
    "license": "Apache-2.0",
    "licenseFile": "../LICENSE",
    "homepage": "https://github.com/clintgalendez/SeeRead",
    "resources": {
      "resources/": "resources/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "entitlements.plist",
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": ["libasound2"]
      }
    }
  }
}
